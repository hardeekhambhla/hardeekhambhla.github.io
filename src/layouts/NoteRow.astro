---
import { fmtDate, cap, type Note } from '../lib/posts';
const { note } = Astro.props as { note: Note };
const d = note.data;
---
<li data-folders={d.categories.join(' ')} data-text={`${d.title} ${d.subtitle ?? ''} ${d.tags.join(' ')}`.toLowerCase()}>
  <a class="row" href={note.url}>
    <div class="body">
      <div class="name">{d.title}</div>
      <div class="meta"><b>{fmtDate(note.date)}</b>{d.subtitle}</div>
      <div class="folder">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M3 6.5A2.5 2.5 0 0 1 5.5 4h3.6c.6 0 1.2.3 1.6.7L12 6h6.5A2.5 2.5 0 0 1 21 8.5v9a2.5 2.5 0 0 1-2.5 2.5h-13A2.5 2.5 0 0 1 3 17.5z" /></svg>
        {d.categories.map(cap).join(', ')}
      </div>
    </div>
    {d.image && <img class="thumb" src={d.image} alt="" loading="lazy" />}
  </a>
</li>
