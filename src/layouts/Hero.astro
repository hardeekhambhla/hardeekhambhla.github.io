---
import { Image } from 'astro:assets';
interface Props { src: string; alt?: string; fade?: boolean }
const { src, alt = '', fade = false } = Astro.props;
---
<section class={`hero${fade ? ' fade' : ''}`}>
  <Image src={src} inferSize alt={alt} widths={[800, 1280, 1920, 2560]} sizes="100vw" loading="eager" fetchpriority="high" />
  {!fade && <div class="wrap"><slot /></div>}
</section>
