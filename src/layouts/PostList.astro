---
import { Image } from 'astro:assets';
import { fmtDate, cap, folders, type Note } from '../lib/posts';
const { notes, all, current, filter = false } = Astro.props as { notes: Note[]; all: Note[]; current?: string; filter?: boolean };
---
{filter && (
  <nav class="seg" aria-label="Filter">
    <a href="/" aria-current={!current ? 'page' : undefined}>All</a>
    {folders(all).map(([f]) => <a href={`/categories/${f}/`} aria-current={current === f ? 'page' : undefined}>{cap(f)}</a>)}
  </nav>
)}
<ul class="grid">
  {notes.map((n) => (
    <li>
      <a class="card" href={n.url}>
        {n.data.image && <Image src={n.data.image} inferSize alt="" widths={[480, 800]} sizes="(max-width: 640px) 100vw, 500px" loading="lazy" />}
        <div class="cap">
          <span class="date">{fmtDate(n.date)}</span>
          <h2>{n.data.title}</h2>
        </div>
      </a>
    </li>
  ))}
</ul>
