---
import { Image } from 'astro:assets';
import { fmtDate, cap, folders, type Note } from '../lib/posts';
const { notes, all, current, filter = false } = Astro.props as { notes: Note[]; all: Note[]; current?: string; filter?: boolean };
---
{filter && (
  <nav class="seg" aria-label="Filter">
    <a href="/" aria-current={!current ? 'page' : undefined}>All</a>
    {folders(all).map(([f]) => <a href={`/categories/${f}/`} aria-current={current === f ? 'page' : undefined}>{cap(f)}</a>)}
  </nav>
)}
<ul class="group posts">
  {notes.map((n) => (
    <li>
      <a class="post" href={n.url}>
        {n.data.image && <Image class="thumb" src={n.data.image} inferSize alt="" widths={[144, 216]} sizes="88px" loading="lazy" />}
        <div class="info">
          <h2>{n.data.title}</h2>
          {n.data.subtitle && <p class="desc">{n.data.subtitle}</p>}
          <div class="when">{fmtDate(n.date)}{n.data.categories[0] && ` · ${cap(n.data.categories[0])}`}</div>
        </div>
        <svg viewBox="0 0 8 14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m1 1 6 6-6 6" /></svg>
      </a>
    </li>
  ))}
</ul>
