---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  nav?: 'about';
}
const site = 'Hardee Khambhla';
const { title, description = "hi, I'm Hardee. I enjoy listening to other people's stories and sharing my own.", image, nav } = Astro.props;
const full = title ? `${title} · ${site}` : site;
const url = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#faf8f5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#16130f" media="(prefers-color-scheme: dark)" />
    <title>{full}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <link rel="icon" href="https://github.com/hardeekhambhla/blog-assets/raw/main/Logo.png" />
    <link rel="alternate" type="application/rss+xml" title={site} href="/feed.xml" />
    <meta property="og:title" content={full} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
  </head>
  <body>
    <div class="wrap">
      <header class="site">
        <a class="brand" href="/">{site}</a>
        <nav>
          <a href="/about/" aria-current={nav === 'about' ? 'page' : undefined}>About</a>
        </nav>
      </header>
      <main>
        <slot />
      </main>
      <footer class="foot">
        <span>© {new Date().getFullYear()} {site}</span>
        <a href="/feed.xml">RSS</a>
      </footer>
    </div>
  </body>
</html>
