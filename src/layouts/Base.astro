---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  back?: { href: string; label: string };
  barTitle?: string;
}
const site = 'Hardee Khambhla';
const { title, description = "hi, I'm Hardee. I enjoy listening to other people's stories and sharing my own.", image, back, barTitle } = Astro.props;
const full = title ? `${title} · ${site}` : site;
const url = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#f2f2f7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <title>{full}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <link rel="icon" href="https://github.com/hardeekhambhla/blog-assets/raw/main/Logo.png" />
    <link rel="alternate" type="application/rss+xml" title={site} href="/feed.xml" />
    <meta property="og:title" content={full} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
  </head>
  <body>
    <header class="bar" id="bar">
      <div class="wrap">
        {back ? (
          <a href={back.href}>
            <svg viewBox="0 0 12 20" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M10 2 2 10l8 8" /></svg>
            {back.label}
          </a>
        ) : <span />}
        <span class="title">{barTitle}</span>
        <a href="/about/">About</a>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <script is:inline>
      const bar = document.getElementById('bar');
      const onScroll = () => bar.classList.toggle('scrolled', scrollY > 40);
      addEventListener('scroll', onScroll, { passive: true }); onScroll();
    </script>
  </body>
</html>
