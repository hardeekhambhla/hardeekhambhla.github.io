---
import Base from '../../layouts/Base.astro';
import { getNotes, folders, cap } from '../../lib/posts';
const notes = await getNotes();
---
<Base title="Folders" back={{ href: '/', label: 'Notes' }} barTitle="Folders">
  <h1 class="large">Folders</h1>
  <ul class="list">
    <li>
      <a class="row" href="/">
        <svg class="folder-ico big" viewBox="0 0 24 24" fill="currentColor"><path d="M3 6.5A2.5 2.5 0 0 1 5.5 4h3.6c.6 0 1.2.3 1.6.7L12 6h6.5A2.5 2.5 0 0 1 21 8.5v9a2.5 2.5 0 0 1-2.5 2.5h-13A2.5 2.5 0 0 1 3 17.5z" /></svg>
        <div class="body"><div class="name">All Notes</div></div>
        <span class="count">{notes.length}</span>
        <svg class="chev" viewBox="0 0 8 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m1 1 6 6-6 6" /></svg>
      </a>
    </li>
    {folders(notes).map(([f, n]) => (
      <li>
        <a class="row" href={`/categories/${f}/`}>
          <svg class="folder-ico big" viewBox="0 0 24 24" fill="currentColor"><path d="M3 6.5A2.5 2.5 0 0 1 5.5 4h3.6c.6 0 1.2.3 1.6.7L12 6h6.5A2.5 2.5 0 0 1 21 8.5v9a2.5 2.5 0 0 1-2.5 2.5h-13A2.5 2.5 0 0 1 3 17.5z" /></svg>
          <div class="body"><div class="name">{cap(f)}</div></div>
          <span class="count">{n}</span>
          <svg class="chev" viewBox="0 0 8 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m1 1 6 6-6 6" /></svg>
        </a>
      </li>
    ))}
  </ul>
</Base>
