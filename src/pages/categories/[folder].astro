---
import Base from '../../layouts/Base.astro';
import PostList from '../../layouts/PostList.astro';
import { getNotes, folders, cap } from '../../lib/posts';

export async function getStaticPaths() {
  const notes = await getNotes();
  return folders(notes).map(([folder]) => ({
    params: { folder },
    props: { notes: notes.filter((n) => n.data.categories.includes(folder)), all: notes },
  }));
}
const { folder } = Astro.params;
const { notes, all } = Astro.props;
---
<Base title={cap(folder!)} wide>
  <h1 class="page-title">{cap(folder!)}</h1>
  <PostList notes={notes} all={all} current={folder} filter />
</Base>
