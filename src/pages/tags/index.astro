---
import Base from '../../layouts/Base.astro';
import { getNotes, tagList, cap } from '../../lib/posts';
const tags = tagList(await getNotes());
---
<Base title="Topics">
  <h1 class="page-title">Topics</h1>
  <ul class="group">
    {tags.map(([t, n]) => (
      <li>
        <a class="row" href={`/tags/${t}/`}>
          <div class="body"><b>{cap(t)}</b></div>
          <span class="count">{n}</span>
          <svg viewBox="0 0 8 14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m1 1 6 6-6 6" /></svg>
        </a>
      </li>
    ))}
  </ul>
</Base>
