---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Comments from '../layouts/Comments.astro';
import Hero from '../layouts/Hero.astro';
import { getNotes, fmtDate, cap } from '../lib/posts';

export async function getStaticPaths() {
  const notes = await getNotes();
  return notes.map((note, i) => ({
    // dev server strips .html from requests; build keeps it
    params: { path: import.meta.env.DEV ? note.url.slice(1, -5) : note.url.slice(1) },
    props: { note, newer: notes[i - 1], older: notes[i + 1] },
  }));
}
const { note, newer, older } = Astro.props;
const { Content } = await render(note);
const d = note.data;
const minutes = Math.max(1, Math.round((note.body ?? '').split(/\s+/).length / 220));
---
<Base title={d.title} description={d.subtitle} image={d.image} overlay={!!d.image}>
  {d.image && (
    <Hero slot="hero" short src={d.image}>
      <h1>{d.title}</h1>
      {d.subtitle && <p class="sub">{d.subtitle}</p>}
      <div class="meta">{fmtDate(note.date)} · {minutes} min read{d.categories[0] && <> · <a href={`/categories/${d.categories[0]}/`}>{cap(d.categories[0])}</a></>}</div>
    </Hero>
  )}
  <div class="body-top"></div>
  <article>
    {!d.image && <h1 class="page-title">{d.title}</h1>}
    <div class="prose"><Content /></div>
  </article>

  {(newer || older) && (
    <nav class="pn">
      {older && <a href={older.url}><span>← Older</span>{older.data.title}</a>}
      {newer && <a class="next" href={newer.url}><span>Newer →</span>{newer.data.title}</a>}
    </nav>
  )}

  <Comments post={note.slug} />

  <dialog class="lightbox" id="lb"><img alt="" /></dialog>
  <script is:inline>
    const lb = document.getElementById('lb');
    document.querySelectorAll('a.photo-swipe').forEach((a) =>
      a.addEventListener('click', (e) => { e.preventDefault(); lb.querySelector('img').src = a.href; lb.showModal(); }));
    lb.addEventListener('click', () => lb.close());
  </script>
</Base>
